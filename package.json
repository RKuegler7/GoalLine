{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "qa": "vite build && playwright test",
        "audit:before": "vite build && playwright test -c qa/audit.config.js",
        "audit:after": "vite build && playwright test -c qa/audit.config.js",
        "audit:compare": "node qa/audit/compare.mjs",
        "smoke": "node qa/smoke.mjs"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.65.0",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@hotwired/turbo": "^8.0.23",
        "cropperjs": "^1.6.2"
    }
}
