option_settings:
  # Serve the site from Laravel's public folder instead of the project root.
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /public
    composer_options: --no-dev --optimize-autoloader
    memory_limit: 256M

  # One small server for the private beta. Change the instance type in the console if it ever needs more.
  aws:elasticbeanstalk:environment:
    EnvironmentType: SingleInstance

  # Non-secret production settings. Secrets (APP_KEY, the database password, AWS keys, the Anthropic and
  # VAPID keys, mail credentials) are set in the Elastic Beanstalk console, never in the repo.
  aws:elasticbeanstalk:application:environment:
    APP_NAME: GoalLine
    APP_ENV: production
    APP_DEBUG: false
    APP_TIMEZONE: America/New_York
    LOG_CHANNEL: stack
    LOG_STACK: daily
    LOG_LEVEL: error
    DB_CONNECTION: mysql
    DB_PORT: 3306
    SESSION_DRIVER: database
    SESSION_SECURE_COOKIE: true
    CACHE_STORE: database
    QUEUE_CONNECTION: database
    UPLOADS_DISK: s3
    MAIL_MAILER: smtp
    MAIL_PORT: 587
    MAIL_SCHEME: smtp
    BETA_INVITE_ONLY: true
