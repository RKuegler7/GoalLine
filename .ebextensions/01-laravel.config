option_settings:
  # Serve the site from Laravel's public folder instead of the project root.
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /public
    composer_options: --no-dev --optimize-autoloader

  # Non-secret settings for a single instance with no database.
  # APP_KEY is a secret: set it in the Elastic Beanstalk console, not here.
  aws:elasticbeanstalk:application:environment:
    APP_ENV: production
    APP_DEBUG: false
    APP_TIMEZONE: America/New_York
    LOG_LEVEL: error
    SESSION_DRIVER: file
    CACHE_STORE: file
    QUEUE_CONNECTION: sync
