APP_NAME=GoalLine
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/New_York

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true in production (https only); .ebextensions sets it.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@goalline.app"
MAIL_FROM_NAME="${APP_NAME}"
# Seconds to wait for the mail server before retrying later.
MAIL_TIMEOUT=15

# Where members' photos and plan files go: local (this computer) or s3 (production, so they survive deploys).
# On Elastic Beanstalk, leave the AWS keys blank: the server's role gives it access to the bucket.
UPLOADS_DISK=local
# Where proof photos go (default: the same disk as other uploads).
PROOF_DISK=uploads

# One-click demo at /demo (and the "Try the demo" button). Demo worlds are deleted after DEMO_TTL_HOURS.
DEMO_ENABLED=true
DEMO_TTL_HOURS=24
# Demo visitors get saved sample coach answers (no API calls). Set true to use the real coach in demos.
DEMO_LIVE_AI=false
# New demos an hour: per network address, per browser, and in total. Returning to your own demo never counts.
DEMO_STARTS_PER_HOUR=30
DEMO_STARTS_PER_BROWSER=10
DEMO_STARTS_PER_HOUR_TOTAL=400
DEMO_AI_REQUESTS_PER_VISITOR=3
DEMO_AI_REQUESTS_PER_DAY=40

# The visitor's real address behind CloudFront (see App\Http\Middleware\TrustCloudFront). REMOTE_ADDR trusts only
# the server's direct caller, which is CloudFront on the single-instance setup. Behind a load balancer too, set this to
# its private range (for example 172.31.0.0/16) and turn on CLOUDFRONT_VIEWER_ADDRESS with that header forwarded.
TRUSTED_PROXIES=REMOTE_ADDR
CLOUDFRONT_VIEWER_ADDRESS=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Seconds per attempt (queued planning), retries, and the short timeout for the caption helper.
ANTHROPIC_TIMEOUT=600
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_QUICK_TIMEOUT=20
# AI caption suggestions on posts (on by default).
CAPTION_SUGGESTIONS=true

VITE_APP_NAME="${APP_NAME}"

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:hello@goalline.app"

# Private beta and spend limits
ADMIN_EMAILS=
BETA_INVITE_ONLY=true
# Public "email us" address on the About page; shown only when set.
CONTACT_EMAIL=
# Production sits behind CloudFront; .ebextensions sets it.
BEHIND_CLOUDFRONT=false
# How long an email verification link works.
VERIFICATION_LINK_HOURS=48
AI_DAILY_REQUESTS_PER_MEMBER=20
AI_DAILY_BUDGET_USD=2
AI_MONTHLY_BUDGET_USD=20
AI_INPUT_USD_PER_MILLION_TOKENS=5
AI_OUTPUT_USD_PER_MILLION_TOKENS=25

# Outbound messaging switches. In production each is OFF unless set to true here (or as an Elastic Beanstalk
# environment property). Off skips the email (or push) but still puts the notification in the member's Inbox.
# Verification, password reset and league invites sent by email are never switched off. Demo accounts never get email.
GOALLINE_EMAIL_REMINDERS=false
GOALLINE_EMAIL_NUDGES=false
GOALLINE_EMAIL_RECAPS=false
GOALLINE_EMAIL_NOTIFICATIONS=false
GOALLINE_PUSH=false
